@startuml
title <size:24>Component View: RutaColca - API Core</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(PayPal, "PayPal", $descr="Proveedor propuesto para turistas extranjeros; contrato pendiente.", $tags="", $link="")

System_Boundary("RutaColca_boundary", "RutaColca", $tags="") {
  Container_Boundary("RutaColca.APICore_boundary", "API Core", $tags="") {
    Component(RutaColca.APICore.AdaptadorPayPal, "AdaptadorPayPal", $techn="Java / HTTPS", $descr="Traduce API y avisos del proveedor PayPal.", $tags="", $link="")
    Component(RutaColca.APICore.ConfirmarPago, "ConfirmarPago", $techn="Java", $descr="Verifica aviso, referencia y estado; confirma idempotentemente.", $tags="", $link="")
    Component(RutaColca.APICore.IniciarPago, "IniciarPago", $techn="Java", $descr="Crea intento vinculado a reserva y proveedor autorizado.", $tags="", $link="")
    Component(RutaColca.APICore.ProveedorPago, "ProveedorPago", $techn="Interfaz Java", $descr="Contrato de inicio y consulta de pagos.", $tags="", $link="")
    Component(RutaColca.APICore.AdaptadorPasarelaActual, "AdaptadorPasarelaActual", $techn="Java / HTTPS", $descr="Traduce respuestas de la pasarela existente.", $tags="", $link="")
  }

  ContainerDb(RutaColca.PostgreSQL, "PostgreSQL", $techn="PostgreSQL 16", $descr="Salidas, reservas, pagos y claves idempotentes.", $tags="", $link="")
}

Rel(RutaColca.APICore.IniciarPago, RutaColca.APICore.ProveedorPago, "Solicita inicio de pago", $techn="Java", $tags="", $link="")
Rel(RutaColca.APICore.ProveedorPago, RutaColca.APICore.AdaptadorPasarelaActual, "Delega a pasarela vigente", $techn="Java", $tags="", $link="")
Rel(RutaColca.APICore.ProveedorPago, RutaColca.APICore.AdaptadorPayPal, "Delega a PayPal", $techn="Java", $tags="", $link="")
Rel(RutaColca.APICore.AdaptadorPayPal, PayPal, "Inicia y consulta intento", $techn="HTTPS", $tags="", $link="")
Rel(PayPal, RutaColca.APICore.ConfirmarPago, "Notifica resultado autenticado", $techn="HTTPS", $tags="", $link="")
Rel(RutaColca.APICore.ConfirmarPago, RutaColca.APICore.AdaptadorPayPal, "Consulta estado para conciliar", $techn="Java", $tags="", $link="")
Rel(RutaColca.APICore.IniciarPago, RutaColca.PostgreSQL, "Registra intento y referencia", $techn="JDBC/SQL", $tags="", $link="")
Rel(RutaColca.APICore.ConfirmarPago, RutaColca.PostgreSQL, "Actualiza reserva idempotentemente", $techn="JDBC/SQL", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml